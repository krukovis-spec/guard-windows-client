/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src 'self'; img-src 'self' data:; manifest-src 'self'; worker-src 'self'; style-src 'self'; script-src 'self'
