<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>../../src/Guard.Child/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Guard.Protocol/Guard.Protocol.csproj" />
    <!-- No production backend/entry/Windows assembly, IPC, network or system changes. -->
    <Page Include="../../src/Guard.Child/ChildWindow.xaml" Link="ChildWindow.xaml" />
    <Compile Include="../../src/Guard.Child/ChildWindow.xaml.cs" Link="ChildWindow.xaml.cs" />
    <Compile Include="../../src/Guard.Child/IChildBackend.cs" Link="IChildBackend.cs" />
  </ItemGroup>
</Project>
