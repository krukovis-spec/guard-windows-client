<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Guard.Windows/Guard.Windows.csproj" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Exact production view and handlers, not a visual replica. No production entry/backend. -->
    <Page Include="../../src/Guard.Setup/SetupWindow.xaml" Link="SetupWindow.xaml" />
    <Compile Include="../../src/Guard.Setup/SetupWindow.xaml.cs" Link="SetupWindow.xaml.cs" />
    <Compile Include="../../src/Guard.Setup/SetupWindow.Enrollment.cs" Link="SetupWindow.Enrollment.cs" />
    <Compile Include="../../src/Guard.Setup/ISetupBackend.cs" Link="ISetupBackend.cs" />
    <Compile Include="../../src/Guard.Setup/EnrollmentView.cs" Link="EnrollmentView.cs" />
    <Compile Include="../../src/Guard.Setup/EnrollmentQr.cs" Link="EnrollmentQr.cs" />
  </ItemGroup>
</Project>
