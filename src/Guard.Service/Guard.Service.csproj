<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guard.Application\Guard.Application.csproj" />
    <ProjectReference Include="..\Guard.Contracts\Guard.Contracts.csproj" />
    <ProjectReference Include="..\Guard.Domain\Guard.Domain.csproj" />
    <ProjectReference Include="..\Guard.Protocol\Guard.Protocol.csproj" />
    <ProjectReference Include="..\Guard.Storage\Guard.Storage.csproj" />
    <ProjectReference Include="..\Guard.Windows\Guard.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="[10.0.10]" />
  </ItemGroup>

  <!-- Public release pins only: never pass credentials to MSBuild. No development trust fallback. -->
  <ItemGroup Condition="'$(GuardRelayOrigin)' != '' And '$(GuardAndroidSignerSha256)' != '' And '$(GuardMinimumAndroidVersion)' != ''">
    <AssemblyMetadata Include="Guard.Enrollment.RelayOrigin" Value="$(GuardRelayOrigin)" />
    <AssemblyMetadata Include="Guard.Enrollment.AndroidSignerSha256" Value="$(GuardAndroidSignerSha256)" />
    <AssemblyMetadata Include="Guard.Enrollment.MinimumAndroidVersion" Value="$(GuardMinimumAndroidVersion)" />
  </ItemGroup>
  <Target Name="RequireCompleteEnrollmentPins" BeforeTargets="GenerateAssemblyInfo"
      Condition="'$(GuardRelayOrigin)' != '' Or '$(GuardAndroidSignerSha256)' != '' Or '$(GuardMinimumAndroidVersion)' != ''">
    <Error Condition="'$(GuardRelayOrigin)' == '' Or '$(GuardAndroidSignerSha256)' == '' Or '$(GuardMinimumAndroidVersion)' == ''"
        Text="Guard enrollment release pins must supply relay origin, Android certificate SHA256 and minimum version together." />
  </Target>
</Project>
